<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rpp_localization</name>
  <version>1.0.0</version>
  <description>Runtime-sized RPP estimation plugins with threaded generic and optional navigation ROS adapters.</description>

  <maintainer email="luka.mandic@fer.hr">Luka Mandic</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>angles</depend>
  <depend>eigen</depend>
  <depend>rpp_cpp</depend>
  <depend>rpp_interfaces</depend>
  <depend>rpp_ros2</depend>
  <depend>rpp_ros_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>


  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosbag2_interfaces</test_depend>
  <test_depend>rosbag2_transport</test_depend>
  <test_depend>rosbag2_storage_mcap</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>robot_localization</test_depend>
  <test_depend>rpp_plugin_registrator</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
